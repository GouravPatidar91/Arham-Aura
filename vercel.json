{
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(Images|Product Images|Notes Images|Founder)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
